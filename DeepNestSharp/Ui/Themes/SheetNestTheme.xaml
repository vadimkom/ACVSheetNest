<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══ SheetNest theme ═══
       Standard controls keep WPF's own Windows look; this file only supplies the palette (Windows light
       grays and the Windows accent blue) and the app's keyed styles. EVERY style here is KEYED — never add
       an implicit (TargetType-only) style: it would leak into Xceed up/down templates, the Add Sheet
       ContextMenu, GridView headers and RotationSelector. -->

  <!-- Accent: Windows blue for values and selection, Windows red for danger. -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#0067C0" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#1975C5" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#005A9E" />
  <SolidColorBrush x:Key="Brush.AccentTint" Color="#CCE4F7" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#C42B1C" />
  <SolidColorBrush x:Key="Brush.DangerHover" Color="#B62D1F" />
  <SolidColorBrush x:Key="Brush.DangerPressed" Color="#A12117" />

  <!-- Surfaces: the standard Windows control face; white for list/data areas. -->
  <SolidColorBrush x:Key="Brush.Window" Color="#F3F3F3" />
  <SolidColorBrush x:Key="Brush.Panel" Color="#F3F3F3" />
  <SolidColorBrush x:Key="Brush.StatusBar" Color="#EBEBEB" />
  <SolidColorBrush x:Key="Brush.Card" Color="White" />
  <SolidColorBrush x:Key="Brush.Hover" Color="#E5F1FB" />
  <SolidColorBrush x:Key="Brush.Pressed" Color="#CCE4F7" />

  <!-- The gray around a sheet in the drawing views, and the panels that float over it. -->
  <SolidColorBrush x:Key="Brush.Workspace" Color="#8A8F94" />
  <SolidColorBrush x:Key="Brush.Overlay" Color="#F2FFFFFF" />

  <!-- Borders. -->
  <SolidColorBrush x:Key="Brush.Border" Color="#C8C8C8" />
  <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#E0E0E0" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="#8A8A8A" />

  <!-- Text. -->
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1B1B1B" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#444444" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#606060" />

  <!-- Toolbar/dialog button: the standard button, only spacing/size here. -->
  <Style x:Key="ModernButton" TargetType="Button">
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="MinWidth" Value="72" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The primary action (NEST / dialog OK): the standard button, in bold. -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,5" />
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
  </Style>

  <!-- Square icon button (✎ / ✕). -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Thin vertical divider between toolbar groups. -->
  <Style x:Key="ToolbarSeparator" TargetType="Rectangle">
    <Setter Property="Width" Value="1" />
    <Setter Property="Fill" Value="{StaticResource Brush.Border}" />
    <Setter Property="Margin" Value="8,4" />
  </Style>

  <!-- Small muted caption/hint text. -->
  <Style x:Key="CaptionText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
  </Style>

  <!-- "Available 31/31" cell. -->
  <Style x:Key="CountBadge" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.AccentTint}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style x:Key="CountBadgeText" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.AccentPressed}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SettingLabel" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,6,10,6" />
  </Style>

  <Style x:Key="StatusValue" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="4,0,16,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="StatusLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    <Setter Property="Margin" Value="12,0,2,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The four workflow steps (1. Models | 2. Sheets | 3. Nesting | 4. Layout), and the sub-view toggles
       (e.g. DXF layout / report). Flat, with the current one tinted in the accent — the way Windows marks
       a selected item. The default focus rectangle stays, so the keyboard user can see where they are. -->
  <Style x:Key="NavModeRadioStyle" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="border" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                  CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.AccentTint}" />
              <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.AccentPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ModernRadioButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource NavModeRadioStyle}">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Margin" Value="1,0" />
  </Style>

</ResourceDictionary>

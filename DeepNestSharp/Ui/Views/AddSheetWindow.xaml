<Window x:Class="DeepNestSharp.Ui.Views.AddSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:ui="clr-namespace:DeepNestSharp.Ui"
        xmlns:conv="clr-namespace:DeepNestSharp.Ui.Converters"
        Title="Custom sheet size"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Window.Resources>
    <conv:PriorityToOptionConverter x:Key="PriorityToOption" />
  </Window.Resources>
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="130" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="headerText" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10"
               Text="Sheet size in millimeters (width = the long side)." Foreground="{StaticResource Brush.TextMuted}" />

    <TextBlock x:Name="widthLabel" Grid.Row="1" Grid.Column="0" Text="Width (mm)" VerticalAlignment="Center" Margin="0,0,10,6" />
    <xctk:IntegerUpDown x:Name="widthUpDown" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="25000" Value="3000" Margin="0,0,0,6" />

    <TextBlock x:Name="heightLabel" Grid.Row="2" Grid.Column="0" Text="Height (mm)" VerticalAlignment="Center" Margin="0,0,10,6" />
    <xctk:IntegerUpDown x:Name="heightUpDown" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="25000" Value="1500" Margin="0,0,0,6" />

    <TextBlock x:Name="qtyLabel" Grid.Row="3" Grid.Column="0" Text="Quantity" VerticalAlignment="Center" Margin="0,0,10,6" />
    <xctk:IntegerUpDown x:Name="qtyUpDown" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="100000" Value="1" Margin="0,0,0,6" />

    <TextBlock x:Name="priorityLabel" Grid.Row="4" Grid.Column="0" Text="Priority" VerticalAlignment="Center" Margin="0,0,10,6" />
    <ComboBox x:Name="priorityCombo" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6"
              DisplayMemberPath="Display" SelectedValuePath="Value"
              ItemsSource="{Binding Source={x:Static ui:PriorityHelper.CurrentOptions}}"
              ToolTip="{ui:Tr Sheet_PriorityTip}" />

    <CheckBox x:Name="unlimitedCheck" Grid.Row="5" Grid.Column="1" Content="Unlimited" Margin="0,0,0,6"
              Checked="OnUnlimitedChanged" Unchecked="OnUnlimitedChanged"
              ToolTip="{ui:Tr Sheet_UnlimitedTip}" />

    <CheckBox x:Name="rememberCheck" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Content="Remember as preset" Margin="0,4,0,0"
              ToolTip="{ui:Tr Sheet_RememberTip}" />

    <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="okButton" Style="{StaticResource PrimaryButton}" Content="Add" Width="88" FontSize="13" Padding="0,6" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
      <Button x:Name="cancelButton" Style="{StaticResource ModernButton}" Content="Cancel" Width="80" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>

<Window x:Class="DeepNestSharp.Ui.Views.EditPartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:conv="clr-namespace:DeepNestSharp.Ui.Converters"
        xmlns:uc="clr-namespace:DeepNestSharp.Ui.UserControls"
        xmlns:ui="clr-namespace:DeepNestSharp.Ui"
        Title="{ui:Tr Part_Title}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Panel}">
  <Window.Resources>
    <conv:PartPreviewConverter x:Key="PartPreview" />
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Part file -->
    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="{ui:Tr Part_File}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox x:Name="partFileText" IsReadOnly="True" Background="White" Padding="4,3" MinWidth="420"
               VerticalContentAlignment="Center" />
    </DockPanel>

    <!-- Preview + Quantity (left) | Settings (right) -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,12,0">
        <Border Width="150" Height="130" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1">
          <Image x:Name="previewImage" Stretch="Uniform" Margin="8" />
        </Border>

        <GroupBox Header="{ui:Tr Part_Quantity}" Margin="0,10,0,0" Padding="6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{ui:Tr Part_Required}" VerticalAlignment="Center" Margin="0,0,10,6" />
            <xctk:IntegerUpDown Grid.Row="0" Grid.Column="1" x:Name="requiredUpDown" Minimum="0" Maximum="100000"
                                Width="70" HorizontalAlignment="Left" Margin="0,0,0,6"
                                ToolTip="{ui:Tr Part_RequiredTip}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{ui:Tr Part_Extra}" VerticalAlignment="Center" Margin="0,0,10,6" />
            <xctk:IntegerUpDown Grid.Row="1" Grid.Column="1" x:Name="extraUpDown" Minimum="0" Maximum="100000"
                                Width="70" HorizontalAlignment="Left" Margin="0,0,0,6"
                                ToolTip="{ui:Tr Part_ExtraTip}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{ui:Tr Part_Mirrored}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <xctk:IntegerUpDown Grid.Row="2" Grid.Column="1" x:Name="mirroredUpDown" Minimum="0" Maximum="100000"
                                Width="70" HorizontalAlignment="Left"
                                ToolTip="{ui:Tr Part_MirroredTip}" />

            <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="fillSheetsCheck" Margin="0,8,0,0"
                      Content="{ui:Tr Part_FillSheets}" ToolTip="{ui:Tr Tip_PartFill}"
                      Checked="OnFillSheetsChanged" Unchecked="OnFillSheetsChanged" />
          </Grid>
        </GroupBox>

        <!-- Flipping the part itself, for a drawing that came the wrong hand: applied on OK. -->
        <GroupBox Header="{ui:Tr Part_Flip}" Margin="0,10,0,0" Padding="6">
          <StackPanel>
            <CheckBox x:Name="flipLeftRightCheck" Content="{ui:Tr Part_FlipLeftRight}" ToolTip="{ui:Tr Tip_FlipLeftRight}" Margin="0,0,0,4" />
            <CheckBox x:Name="flipUpDownCheck" Content="{ui:Tr Part_FlipUpDown}" ToolTip="{ui:Tr Tip_FlipUpDown}" />
          </StackPanel>
        </GroupBox>
      </StackPanel>

      <GroupBox Grid.Column="1" Header="{ui:Tr Part_Settings}" Padding="8" VerticalAlignment="Stretch">
        <StackPanel MinWidth="300">
          <TextBlock Text="{ui:Tr Part_Orientations}" Margin="0,0,0,4" />
          <uc:RotationSelector x:Name="rotationSelector" HorizontalAlignment="Stretch"
                               ToolTip="{ui:Tr Part_OrientationsTip}" />
          <TextBlock x:Name="geoHint" FontSize="10" Foreground="{StaticResource Brush.Accent}" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
          <TextBlock x:Name="warnHint" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Danger}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

          <TextBlock Text="{ui:Tr Part_Spacing}" Margin="0,14,0,4" />
          <StackPanel Orientation="Horizontal">
            <xctk:DoubleUpDown x:Name="spacingUpDown" Width="90" Minimum="0" Increment="0.05" FormatString="0.###"
                               ToolTip="{ui:Tr Part_SpacingTip}" />
            <TextBlock Text="{ui:Tr Part_Units}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource Brush.TextMuted}" />
          </StackPanel>

          <!-- A part starts safely off and becomes eligible only after the operator explicitly changes
               this selector. -->
          <StackPanel x:Name="commonCuttingGroup" Visibility="Collapsed">
            <TextBlock Text="{ui:Tr Part_CommonCutting}" Margin="0,14,0,4" />
            <ComboBox x:Name="commonCuttingCombo" Width="200" HorizontalAlignment="Left"
                      ToolTip="{ui:Tr Part_CommonCuttingTip}" />
            <TextBlock x:Name="commonCuttingHint" Visibility="Collapsed" Margin="0,4,0,0" FontSize="10"
                       Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" />
          </StackPanel>

          <TextBlock Text="{ui:Tr Part_Priority}" Margin="0,14,0,4" />
          <ComboBox x:Name="priorityCombo" Width="150" HorizontalAlignment="Left"
                    ToolTip="{ui:Tr Part_PriorityTip}" />
        </StackPanel>
      </GroupBox>
    </Grid>

    <!-- OK / Cancel -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Style="{StaticResource PrimaryButton}" Content="{ui:Tr Btn_OK}" Width="96" FontSize="13" Padding="0,6" IsDefault="True" Click="OnOk" />
      <Button Style="{StaticResource ModernButton}" Content="{ui:Tr Btn_Cancel}" MinWidth="84" Margin="10,0,0,0" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>

<Window x:Class="DeepNestSharp.Ui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:userControls="clr-namespace:DeepNestSharp.Ui.UserControls"
        xmlns:converters="clr-namespace:DeepNestSharp.Ui.Converters"
        xmlns:ui="clr-namespace:DeepNestSharp.Ui"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:placement="clr-namespace:DeepNestLib.Placement;assembly=DeepNestLib.Core"
        xmlns:nestproject="clr-namespace:DeepNestLib.NestProject;assembly=DeepNestLib.Core"
        mc:Ignorable="d"
        Title="{Binding Title}" Icon="/Branding/sheetnest-icon.png"
        Height="850" Width="1340" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnWindowDrop" DragOver="OnWindowDragOver" KeyDown="MainWindow_KeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:PartPreviewConverter x:Key="PartPreview" />
    <converters:SheetPreviewConverter x:Key="SheetPreview" />
    <converters:RgbToBrushConverter x:Key="RgbToBrush" />
    <converters:InverseBooleanConverter x:Key="InvertBool" />
    <converters:PriorityToOptionConverter x:Key="PriorityToOption" />

    <Style x:Key="ColourSwatchButton" TargetType="Button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter x:Name="content" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="content" Property="Opacity" Value="0.75" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FlatGridViewColumnHeader" TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="#E0E0E0" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <ObjectDataProvider x:Key="PlacementTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="placement:PlacementTypeEnum" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="StrictAngleValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
      <ObjectDataProvider.MethodParameters>
        <x:Type TypeName="nestproject:AnglesEnum" />
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Row 0: Menu Bar -->
    <DockPanel Grid.Row="0" Background="{DynamicResource Brush.Window}">
      <Menu Background="Transparent" VerticalAlignment="Center">
        <MenuItem x:Name="menuFile" Header="_Файл">
          <MenuItem x:Name="menuNewProject" Header="Новый проект" Command="{Binding CreateNestProjectCommand}" />
          <MenuItem x:Name="menuOpenProject" Header="Открыть проект..." Command="{Binding LoadNestProjectCommand}" />
          <MenuItem x:Name="recentProjectsMenu" Header="Последние проекты" SubmenuOpened="OnRecentProjectsOpened">
            <MenuItem x:Name="recentEmptyItem" Header="(пусто)" IsEnabled="False" />
          </MenuItem>
          <Separator />
          <MenuItem x:Name="menuSave" Header="Сохранить" Command="{Binding ActiveDocumentSaveCommand}" />
          <MenuItem x:Name="menuSaveAs" Header="Сохранить как..." Command="{Binding ActiveDocumentSaveAsCommand}" />
          <Separator />
          <MenuItem x:Name="menuExit" Header="Выход" Command="{Binding ExitCommand}" />
        </MenuItem>
        <MenuItem x:Name="menuSettings" Header="_Настройки">
          <MenuItem x:Name="menuOffcut" Header="Деловые отходы..." Click="OnOffcutSettings" />
          <MenuItem x:Name="menuAdvancedSettings" Header="Расширенные настройки..." Click="OnAdvancedSettings" />
          <Separator />
          <MenuItem x:Name="menuLanguage" Header="Язык (Language)">
            <MenuItem x:Name="langRuItem" Header="🇷🇺 Русский" Click="OnLanguageRuClicked" IsCheckable="True" />
            <MenuItem x:Name="langBgItem" Header="🇧🇬 Български" Click="OnLanguageBgClicked" IsCheckable="True" />
            <MenuItem x:Name="langEnItem" Header="🇬🇧 English" Click="OnLanguageEnClicked" IsCheckable="True" />
            <MenuItem x:Name="langDeItem" Header="🇩🇪 Deutsch" Click="OnLanguageDeClicked" IsCheckable="True" />
            <MenuItem x:Name="langFrItem" Header="🇫🇷 Français" Click="OnLanguageFrClicked" IsCheckable="True" />
            <MenuItem x:Name="langEsItem" Header="🇪🇸 Español" Click="OnLanguageEsClicked" IsCheckable="True" />
            <MenuItem x:Name="langPtItem" Header="🇵🇹 Português" Click="OnLanguagePtClicked" IsCheckable="True" />
          </MenuItem>
        </MenuItem>
        <MenuItem x:Name="menuHelp" Header="_Справка">
          <MenuItem x:Name="menuCheckUpdates" Header="Проверить обновления..." Click="OnCheckUpdates" />
          <MenuItem x:Name="menuSendFeedback" Header="Обратная связь..." Click="OnSendFeedback" ToolTip="{ui:Tr Tip_Feedback}" />
          <MenuItem x:Name="menuAbout" Header="О программе" Command="{Binding AboutDialogCommand}" />
        </MenuItem>
      </Menu>
    </DockPanel>

    <!-- Row 1: Main Toolbar + Workflow Mode Switcher -->
    <Border Grid.Row="1" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,5">
      <DockPanel>
        <!-- Project Actions on Left -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="btnNew" Style="{DynamicResource ModernButton}" Margin="2,0" Content="Новый" Command="{Binding CreateNestProjectCommand}" ToolTip="{ui:Tr Tip_New}" />
          <Button x:Name="btnOpen" Style="{DynamicResource ModernButton}" Margin="2,0" Content="Открыть..." Command="{Binding LoadNestProjectCommand}" ToolTip="{ui:Tr Tip_Open}" />
          <Button x:Name="btnSave" Style="{DynamicResource ModernButton}" Margin="2,0" Content="Сохранить" Command="{Binding ActiveDocumentSaveCommand}" ToolTip="{ui:Tr Tip_Save}" />
          <Rectangle Style="{DynamicResource ToolbarSeparator}" Margin="8,2" />
        </StackPanel>

        <!-- Mode Navigation Buttons in Center: 1. Модели | 2. Листы | 3. Нестинг | 4. Раскладка и отчёт -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <RadioButton x:Name="navPartsBtn" GroupName="NavWorkflowModes" Style="{DynamicResource NavModeRadioStyle}"
                       Content="1. Модели (Детали)" IsChecked="True" Checked="OnNavModeChecked" Tag="0"
                       ToolTip="{ui:Tr Tip_NavParts}" />
          <RadioButton x:Name="navSheetsBtn" GroupName="NavWorkflowModes" Style="{DynamicResource NavModeRadioStyle}"
                       Content="2. Листы" Checked="OnNavModeChecked" Tag="1" Margin="4,0,0,0"
                       ToolTip="{ui:Tr Tip_NavSheets}" />
          <RadioButton x:Name="navNestingBtn" GroupName="NavWorkflowModes" Style="{DynamicResource NavModeRadioStyle}"
                       Content="3. Нестинг" Checked="OnNavModeChecked" Tag="2" Margin="4,0,0,0"
                       ToolTip="{ui:Tr Tip_NavNesting}" />
          <RadioButton x:Name="navLayoutBtn" GroupName="NavWorkflowModes" Style="{DynamicResource NavModeRadioStyle}"
                       Content="4. Раскладка и отчёт" Checked="OnNavModeChecked" Tag="3" Margin="4,0,0,0"
                       ToolTip="{ui:Tr Tip_NavLayout}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Row 2: Main Work Area (Dedicated View for each Mode) -->
    <Grid Grid.Row="2">

      <!-- ═══════════════════ SCREEN 1: PARTS (МОДЕЛИ) ═══════════════════ -->
      <Grid x:Name="gridModeParts" Visibility="Visible" AllowDrop="True" Drop="OnPartsDrop" DragOver="OnPartsDragOver">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Parts Top Action Bar -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,6">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="partsCountSummary" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" Text="Деталей: 0 (запрошено: 0 шт.)" />
              <Button x:Name="btnGoToSheets" Style="{DynamicResource PrimaryButton}" Content="Далее: Листы ➔" Click="OnGoToSheets" Margin="4,0" ToolTip="{ui:Tr Tip_GoToSheets}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="btnAddPart" Style="{DynamicResource PrimaryButton}" Content="+ Добавить DXF..." Click="OnAddPartClicked" Margin="3,0" ToolTip="{ui:Tr Tip_AddPart}" />
              <Button x:Name="btnAddShape" Style="{DynamicResource ModernButton}" Content="{ui:Tr Btn_AddShape}" Click="OnAddShapeClicked" Margin="3,0" ToolTip="{ui:Tr Tip_AddShape}" />
              <Button x:Name="btnFillRemnant" Style="{DynamicResource ModernButton}" Content="{ui:Tr Btn_FillRemnant}" Click="OnFillRemnantClicked" Margin="3,0" ToolTip="{ui:Tr Tip_FillRemnant}" />
              <Rectangle Style="{DynamicResource ToolbarSeparator}" Margin="8,2" />
              <TextBlock x:Name="lblMultiplier" Text="Множитель (комплектов):" VerticalAlignment="Center" Margin="0,0,4,0" Style="{DynamicResource CaptionText}" />
              <xctk:IntegerUpDown x:Name="partsMultiplierUpDown" Value="1" Minimum="1" Maximum="10000" Width="55" VerticalAlignment="Center" Margin="0,0,3,0"
                                  ToolTip="Множитель количества деталей (например, число изготавливаемых комплектов)" />
              <Button x:Name="btnApplyMultiplier" Style="{DynamicResource ModernButton}" Content="× Применить" Click="OnApplyPartsMultiplier" Margin="2,0"
                      ToolTip="Умножить количество деталей на указанный множитель" />
              <Rectangle Style="{DynamicResource ToolbarSeparator}" Margin="8,2" />
              <!-- Shown when several parts fill the sheets: as many of each (a kit), or each as many as go on. -->
              <ComboBox x:Name="fillModeCombo" MinWidth="170" VerticalAlignment="Center" Margin="3,0" Visibility="Collapsed"
                        SelectionChanged="OnFillModeChanged" ToolTip="{ui:Tr Tip_FillMode}">
                <ComboBoxItem Content="{ui:Tr Fill_Even}" />
                <ComboBoxItem Content="{ui:Tr Fill_Max}" />
              </ComboBox>
            </StackPanel>
            <TextBlock x:Name="partsHintText" VerticalAlignment="Center" Style="{DynamicResource CaptionText}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="💡 Можно перетащить файлы DXF прямо в эту таблицу (Drag &amp; Drop)" />
          </DockPanel>
        </Border>

        <!-- Parts Table -->
        <Grid Grid.Row="1" Background="White">
          <ListView x:Name="partsListView" SizeChanged="OnPartsListSizeChanged"
                    ItemsSource="{Binding ActiveDocument.ProjectInfo.DetailLoadInfos}"
                    SelectedItem="{Binding ActiveDocument.SelectedDetailLoadInfo}"
                    MouseDoubleClick="OnPartsListDoubleClick"
                    SelectionMode="Extended"
                    PreviewKeyDown="OnPartsListKeyDown"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.Resources>
              <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource FlatGridViewColumnHeader}" />
            </ListView.Resources>
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0,2" />
                <Setter Property="BorderBrush" Value="#E5E5E5" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
              <GridView>
                <!-- Preview Thumbnail -->
                <GridViewColumn x:Name="colHeaderPartPreview" Header="Эскиз" Width="64">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <!-- The sketch is drawn in the part's colour, so it is where the colour is changed too. -->
                      <Button Style="{DynamicResource ColourSwatchButton}" Click="OnPartColorClick" Tag="{Binding}" ToolTip="{ui:Tr Tip_PartColor}" Margin="2">
                        <Border Width="48" Height="48" Background="White" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                          <Image Source="{Binding PreviewSource, Converter={StaticResource PartPreview}}" Stretch="Uniform" Margin="2" />
                        </Border>
                      </Button>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <!-- Part Name & Source -->
                <GridViewColumn x:Name="colHeaderPartName" Header="Деталь (Название / Файл)" Width="280">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel VerticalAlignment="Center" Margin="4,0">
                        <TextBlock Text="{Binding ShownName}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding NestingLabel, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding FlipLabel, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" TextTrimming="CharacterEllipsis">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding FlipLabel, Mode=OneWay}" Value="">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <!-- Quantity (Inline Editable) -->
                <GridViewColumn x:Name="colHeaderPartQty" Header="Количество" Width="118">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Grid VerticalAlignment="Center" Margin="4,0">
                        <StackPanel x:Name="countCell" Orientation="Horizontal">
                          <xctk:IntegerUpDown Width="75" Minimum="0" Maximum="100000" Value="{Binding Quantity, Mode=TwoWay}"
                                              ValueChanged="OnPartQuantityChanged" Tag="{Binding}"
                                              VerticalAlignment="Center" ToolTip="{ui:Tr Tip_PartQty}" />
                          <TextBlock Text="{ui:Tr Unit_Pcs}" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource Brush.TextMuted}" />
                        </StackPanel>
                        <!-- A part that fills the sheets has no count to type: it says so, and how many went on -->
                        <TextBlock x:Name="fillCell" Text="{Binding FillLabel}" Visibility="Collapsed" VerticalAlignment="Center"
                                   FontWeight="SemiBold" ToolTip="{ui:Tr Tip_PartFill}" />
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding FillSheets}" Value="True">
                          <Setter TargetName="countCell" Property="Visibility" Value="Collapsed" />
                          <Setter TargetName="fillCell" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <!-- Mirrored copies on top of the quantity (left/right pairs), next to it -->
                <GridViewColumn x:Name="colHeaderMirrored" Header="{ui:Tr Col_Mirrored}" Width="100">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <xctk:IntegerUpDown Width="75" Minimum="0" Maximum="100000" Value="{Binding MirrorQuantity, Mode=TwoWay}"
                                          ValueChanged="OnPartQuantityChanged" Tag="{Binding}" HorizontalAlignment="Left"
                                          VerticalAlignment="Center" Margin="4,0" ToolTip="{ui:Tr Tip_PartMirrorQty}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <!-- Dimensions -->
                <GridViewColumn x:Name="colHeaderDimensions" Header="Габариты (Ш × В), мм" Width="140">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding SizeLabel, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <!-- Priority -->
                <GridViewColumn x:Name="colHeaderPriority" Header="Приоритет" Width="135">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <ComboBox Width="110"
                                SelectedValue="{Binding Priority, Mode=TwoWay, Converter={StaticResource PriorityToOption}}"
                                SelectedValuePath="Value"
                                DisplayMemberPath="Display"
                                ItemsSource="{Binding Source={x:Static ui:PriorityHelper.CurrentOptions}}"
                                VerticalAlignment="Center" Margin="2,0"
                                ToolTip="{ui:Tr Tip_PartPriority}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <!-- Actions: Details button + Remove -->
                <!-- No status column: how many went on is the nesting step's and the status bar's to say. -->
                <GridViewColumn x:Name="colHeaderPartActions" Header="Действия" Width="100">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{DynamicResource ModernButton}" Content="…" MinWidth="30" Margin="2,0"
                                Click="OnEditPart" Tag="{Binding}"
                                ToolTip="{ui:Tr Tip_PartDetails}" />
                        <Button Style="{DynamicResource IconButton}" Content="✕" Margin="4,0,0,0"
                                ToolTip="{ui:Tr Tip_PartRemove}"
                                Command="{Binding DataContext.ActiveDocument.RemovePartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>

          <!-- Empty Parts Drag & Drop Hint -->
          <Border x:Name="partsEmptyHint" Background="#FBFBFB" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  Margin="40" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10" />
              <TextBlock x:Name="partsEmptyTitle" Text="В проекте пока нет ни одной детали" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" />
              <TextBlock x:Name="partsEmptySub" Text="Перетащите сюда файлы DXF или проекты (Drag &amp; Drop)" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,14" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnAddPartEmpty" Style="{DynamicResource PrimaryButton}" Content="+ Добавить DXF..." Click="OnAddPartClicked" Margin="4,0" />
                <Button Style="{DynamicResource ModernButton}" Content="{ui:Tr Btn_AddShape}" Click="OnAddShapeClicked" Margin="4,0" ToolTip="{ui:Tr Tip_AddShape}" />
                <Button Style="{DynamicResource ModernButton}" Content="{ui:Tr Btn_FillRemnant}" Click="OnFillRemnantClicked" Margin="4,0" ToolTip="{ui:Tr Tip_FillRemnant}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>


      <!-- ═══════════════════ SCREEN 2: SHEETS (ЛИСТЫ) ═══════════════════ -->
      <Grid x:Name="gridModeSheets" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sheets Top Action Bar -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,6">
          <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="sheetsCountSummary" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" Text="Типоразмеров: 0" />
              <Button x:Name="btnBackToParts" Style="{DynamicResource ModernButton}" Content="⮜ Назад к моделям" Click="OnGoToParts" Margin="4,0" ToolTip="{ui:Tr Tip_BackToParts}" />
              <Button x:Name="btnGoToNesting" Style="{DynamicResource PrimaryButton}" Content="Далее: Нестинг ➔" Click="OnGoToNesting" Margin="4,0" ToolTip="{ui:Tr Tip_GoToNesting}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="btnAddSheet" Style="{DynamicResource PrimaryButton}" Content="+ Добавить лист..." Click="OnAddSheetMenu" Margin="3,0" ToolTip="{ui:Tr Tip_AddSheet}" />
              <Button x:Name="btnDeleteSheet" Style="{DynamicResource ModernButton}" Content="Удалить лист" Click="OnRemoveSelectedSheet" Margin="3,0" ToolTip="{ui:Tr Tip_DeleteSheet}" />
              <Rectangle Style="{DynamicResource ToolbarSeparator}" Margin="8,2" />
              <TextBlock x:Name="lblSheetEdgeMargin" Text="Отступ от края листа:" VerticalAlignment="Center" Margin="4,0" />
              <xctk:DoubleUpDown x:Name="sheetEdgeMarginBox" Width="75" Minimum="0" Increment="0.5"
                                 Value="{Binding SvgNestConfigViewModel.SvgNestConfig.SheetSpacing}"
                                 ToolTip="{ui:Tr Tip_EdgeMargin}" />
              <TextBlock x:Name="marginUnitsLabel" Text="in" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{DynamicResource Brush.TextMuted}" />
            </StackPanel>
          </DockPanel>
            <!-- One material and one thickness per job: different metals or gauges are nested as separate jobs.
                 A row of its own, so it fits a portrait monitor. -->
            <StackPanel Orientation="Horizontal" Margin="3,6,0,0">
              <TextBlock Text="{ui:Tr Lbl_Material}" VerticalAlignment="Center" Margin="0,0,4,0" />
              <ComboBox x:Name="materialCombo" Width="170" VerticalAlignment="Center" ToolTip="{ui:Tr Tip_Material}"
                        SelectionChanged="OnMaterialChanged" />
              <TextBlock Text="{ui:Tr Lbl_Thickness}" VerticalAlignment="Center" Margin="14,0,4,0" />
              <ComboBox x:Name="thicknessCombo" Width="80" IsEditable="True" VerticalAlignment="Center" ToolTip="{ui:Tr Tip_Thickness}"
                        SelectionChanged="OnThicknessChosen" LostKeyboardFocus="OnThicknessTyped" KeyDown="OnThicknessKey" />
              <TextBlock x:Name="thicknessUnitsLabel" Text="мм" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{DynamicResource Brush.TextMuted}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Sheets Table -->
        <Grid Grid.Row="1" Background="White">
          <ListView x:Name="sheetsListView"
                    ItemsSource="{Binding ActiveDocument.ProjectInfo.SheetLoadInfos}"
                    SelectedItem="{Binding ActiveDocument.SelectedSheetLoadInfo}"
                    MouseDoubleClick="OnSheetsListDoubleClick"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.Resources>
              <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource FlatGridViewColumnHeader}" />
            </ListView.Resources>
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0,4" />
                <Setter Property="BorderBrush" Value="#E5E5E5" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
              <GridView>
                <!-- The sheet in proportion; an offcut read from a drawing shows its own outline and holes. -->
                <GridViewColumn x:Name="colHeaderSheetPreview" Header="Эскиз" Width="64">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Border Width="48" Height="48" Margin="2" Background="White" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                              ToolTip="{Binding ShapePath, Mode=OneWay}">
                        <Image Stretch="Uniform" Margin="2">
                          <Image.Source>
                            <MultiBinding Converter="{StaticResource SheetPreview}">
                              <Binding Path="ShapePath" Mode="OneWay" />
                              <Binding Path="Width" Mode="OneWay" />
                              <Binding Path="Height" Mode="OneWay" />
                            </MultiBinding>
                          </Image.Source>
                        </Image>
                      </Border>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <!-- Sheet Dimensions -->
                <GridViewColumn x:Name="colHeaderSheetDimensions" Header="Размеры листа (Ширина × Высота), мм" Width="230">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                        <TextBlock FontWeight="Bold" FontSize="13" VerticalAlignment="Center">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} × {1}">
                              <Binding Path="Width" Mode="OneWay" />
                              <Binding Path="Height" Mode="OneWay" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                        <!-- A sheet of any shape, read from a drawing: its file, beside the box round it. -->
                        <TextBlock Text="{Binding ShapeName, Mode=OneWay}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextMuted}" ToolTip="{Binding ShapePath, Mode=OneWay}" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <!-- Quantity -->
                <GridViewColumn x:Name="colHeaderSheetQty" Header="Количество в наличии" Width="170">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                        <xctk:IntegerUpDown Width="80" Minimum="1" Maximum="100000" Value="{Binding Quantity, Mode=TwoWay}"
                                            IsEnabled="{Binding Unlimited, Converter={StaticResource InvertBool}}"
                                            VerticalAlignment="Center" ToolTip="{ui:Tr Tip_SheetQty}" />
                        <TextBlock Text="{ui:Tr Unit_Pcs}" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource Brush.TextMuted}" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <!-- Unlimited Stock Checkbox -->
                <GridViewColumn x:Name="colHeaderSheetUnlimited" Header="Неограниченно" Width="130">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Unlimited, Mode=TwoWay}" Content="{ui:Tr Sheet_UnlimitedShort}"
                                VerticalAlignment="Center" Margin="4,0" ToolTip="{ui:Tr Tip_SheetUnlimited}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <!-- Priority -->
                <GridViewColumn x:Name="colHeaderSheetPriority" Header="Приоритет" Width="130">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <ComboBox Width="110"
                                SelectedValue="{Binding Priority, Mode=TwoWay, Converter={StaticResource PriorityToOption}}"
                                SelectedValuePath="Value"
                                DisplayMemberPath="Display"
                                ItemsSource="{Binding Source={x:Static ui:PriorityHelper.CurrentOptions}}"
                                VerticalAlignment="Center" Margin="2,0"
                                ToolTip="{ui:Tr Tip_SheetPriority}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <!-- Available / Used Status -->
                <GridViewColumn x:Name="colHeaderSheetStatus" Header="Использовано / в наличии" Width="160">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{DynamicResource CountBadge}">
                        <TextBlock Style="{DynamicResource CountBadgeText}" Text="{Binding NestedInfo, Mode=OneWay}" />
                      </Border>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <!-- Actions -->
                <GridViewColumn x:Name="colHeaderSheetActions" Header="Действия" Width="160">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{DynamicResource ModernButton}" Content="{ui:Tr Btn_EditSheet}" Margin="2,0"
                                Click="OnEditSheet" Tag="{Binding}" ToolTip="{ui:Tr Tip_EditSheet}" />
                        <Button Style="{DynamicResource IconButton}" Content="✕" Margin="4,0,0,0"
                                ToolTip="{ui:Tr Tip_RemoveSheet}"
                                Command="{Binding DataContext.ActiveDocument.RemoveSheetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>

          <!-- Empty Sheets Hint -->
          <Border x:Name="sheetsEmptyHint" Background="#FBFBFB" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  Margin="40" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10" />
              <TextBlock x:Name="sheetsEmptyTitle" Text="Листы материала не добавлены" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" />
              <TextBlock x:Name="sheetsEmptySub" Text="{ui:Tr Sheets_EmptySub}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,14" />
              <Button x:Name="btnAddSheetEmpty" Style="{DynamicResource PrimaryButton}" Content="+ Добавить лист..." Click="OnAddSheetMenu" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>


      <!-- ═══════════════════ SCREEN 3: NESTING (НЕСТИНГ) ═══════════════════ -->
      <Grid x:Name="gridModeNesting" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Nesting Control Bar -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,6">
          <DockPanel>
            <!-- Right: Open Layout Button -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="btnOpenLayoutFromNesting" Style="{DynamicResource PrimaryButton}" Content="Открыть раскладку и отчёт ➔"
                      Click="OnGoToLayout" Margin="4,0" ToolTip="{ui:Tr Tip_OpenLayout}" />
            </StackPanel>

            <!-- Left / Center: Controls & Progress -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <!-- Two buttons, two jobs: a draft in seconds for a quote, and the layout that gets cut.
                   Both are tuned in %LOCALAPPDATA%\SheetNest\nest-profiles.json. -->
              <Button x:Name="btnNestDraft" Style="{DynamicResource ModernButton}" Content="{ui:Tr Btn_NestDraft}" Click="OnNest"
                      Padding="10,4" ToolTip="{ui:Tr Tip_NestDraft}" Margin="2,0,4,0" />
              <Button x:Name="btnStartNest" Style="{DynamicResource PrimaryButton}" Content="{ui:Tr Btn_NestCut}" Click="OnNest"
                      Padding="12,4" ToolTip="{ui:Tr Tip_StartNest}" Margin="0,0,4,0" />
              <Button x:Name="cancelNestButton" Style="{DynamicResource DangerButton}" Margin="4,0" Content="■  Остановить"
                      Click="OnCancelNest" Visibility="Collapsed" ToolTip="{ui:Tr Tip_CancelNest}" />
              <Rectangle Style="{DynamicResource ToolbarSeparator}" Margin="8,2" />
              <TextBlock x:Name="nestPhaseText" Style="{DynamicResource StatusValue}" VerticalAlignment="Center"
                         FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" Margin="6,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Two-Pane Work Area: Left = Runs/Iterations Table, Right = DxfViewer Run Preview -->
        <Grid Grid.Row="1" x:Name="nestWorkArea" SizeChanged="OnNestWorkAreaSizeChanged">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" MinWidth="260" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="360" />
          </Grid.ColumnDefinitions>

          <!-- Left Pane: Runs Table -->
          <Border x:Name="runsPane" Grid.Column="0" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
              <!-- Runs Table Header Caption -->
              <Border DockPanel.Dock="Top" Background="#EAEAEA" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,5">
                <DockPanel>
                  <Button x:Name="btnClearRuns" DockPanel.Dock="Right" Style="{DynamicResource ModernButton}" Padding="6,1" Content="🗑 Очистить" Click="OnClearRunsClicked" ToolTip="Очистить список вариантов раскладки" />
                  <TextBlock x:Name="runsListTitle" FontWeight="Bold" FontSize="11" Text="Варианты и прогоны раскладки" VerticalAlignment="Center" />
                </DockPanel>
              </Border>

              <!-- Hint Footer -->
              <Border DockPanel.Dock="Bottom" Background="#F0F0F0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="8,4">
                <TextBlock x:Name="runsListHint" Style="{DynamicResource CaptionText}" Text="💡 Кликните по варианту для предпросмотра; дважды кликните для перехода к раскладке." TextWrapping="Wrap" />
              </Border>

              <!-- Runs ListView -->
              <ListView x:Name="runsListView"
                        MouseDoubleClick="OnRunsListDoubleClick"
                        SelectionChanged="OnRunsListSelectionChanged"
                        BorderThickness="0" Background="White">
                <ListView.Resources>
                  <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource FlatGridViewColumnHeader}" />
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,4" />
                    <Setter Property="BorderBrush" Value="#E5E5E5" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                  <GridView>
                    <GridViewColumn x:Name="colHeaderRunNum" Header="№" Width="46" DisplayMemberBinding="{Binding RunLabel}" />
                    <GridViewColumn x:Name="colHeaderRunUtil" Header="% Утилиз." Width="90">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding UtilizationText}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="colHeaderRunPlaced" Header="Размещено" Width="95" DisplayMemberBinding="{Binding PlacedText}" />
                    <GridViewColumn x:Name="colHeaderRunSheets" Header="Листов" Width="60" DisplayMemberBinding="{Binding SheetsText}" />
                    <GridViewColumn x:Name="colHeaderRunTime" Header="Время" Width="75" DisplayMemberBinding="{Binding TimeText}" />
                  </GridView>
                </ListView.View>
              </ListView>
            </DockPanel>
          </Border>

          <!-- Splitter -->
          <GridSplitter x:Name="runsSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource Brush.BorderSubtle}" />

          <!-- Right Pane: Preview of Selected Run -->
          <Grid x:Name="previewPane" Grid.Column="2" Background="{DynamicResource Brush.Panel}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Metrics bar above preview -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="10,6">
              <DockPanel>
                <TextBlock x:Name="nestPreviewMetricsText" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Text="Предпросмотр раскладки: выберите вариант в списке вариантов" />
              </DockPanel>
            </Border>

            <!-- Run Preview DxfViewer -->
            <Border Grid.Row="1" Margin="2" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <userControls:DxfViewer x:Name="nestDxfViewer" SheetIndex="0" />

                <!-- Every sheet of the previewed nest at a glance; click one to show it. -->
                <Border x:Name="nestLayoutStrip" Grid.Row="1" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0" Padding="6,4" Visibility="Collapsed">
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="nestLayoutItems">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="3" Padding="5,4" Width="130" Background="White" BorderThickness="1"
                                  BorderBrush="{DynamicResource Brush.Border}" CornerRadius="3" Cursor="Hand"
                                  MouseLeftButtonUp="OnNestLayoutCardClick" ToolTip="{ui:Tr Tip_LayoutCard}">
                            <StackPanel>
                              <Image Source="{Binding Thumbnail}" Height="62" Stretch="Uniform" />
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>


      <!-- ═══════════════════ SCREEN 4: LAYOUT & REPORT (РАСКЛАДКА И ОТЧЁТ) ═══════════════════ -->
      <Grid x:Name="gridModeLayout" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Layout Top Action Bar -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,6">
          <DockPanel>
            <!-- Right: Export & Print Buttons -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="btnExportDxf" Style="{DynamicResource ModernButton}" Margin="3,0" Content="📁 Экспорт в DXF" Click="OnExportDxf" ToolTip="{ui:Tr Tip_ExportDxf}" />
              <Button x:Name="btnExportPdf" Style="{DynamicResource ModernButton}" Margin="3,0" Content="📄 Экспорт отчёта (PDF)" Click="OnNestReportPdf" ToolTip="{ui:Tr Tip_ExportPdf}" />
              <Button x:Name="btnPrintReport" Style="{DynamicResource PrimaryButton}" Margin="3,0" Content="🖨️ Печать отчета..." Click="OnPrintReport" ToolTip="{ui:Tr Tip_PrintReport}" />
            </StackPanel>

            <!-- Left: View Toggle (DXF Layout vs Report Preview) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <RadioButton x:Name="viewTypeDxfRadio" GroupName="LayoutViewMode" Style="{DynamicResource ModernRadioButtonStyle}"
                           Content="Чертеж раскладки (DXF)" IsChecked="True" Checked="OnLayoutViewTypeChanged" Margin="2,0" />
              <RadioButton x:Name="viewTypeReportRadio" GroupName="LayoutViewMode" Style="{DynamicResource ModernRadioButtonStyle}"
                           Content="Сводный отчёт" Checked="OnLayoutViewTypeChanged" Margin="2,0" />
              <Rectangle Style="{DynamicResource ToolbarSeparator}" Margin="8,2" />
              <Button x:Name="btnBackToNesting" Style="{DynamicResource ModernButton}" Content="⮜ Вернуться к нестингу" Click="OnGoToNesting" Margin="2,0" ToolTip="{ui:Tr Tip_BackToNesting}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Work Area: DXF Layout Viewer or Report Preview -->
        <Grid Grid.Row="1">

          <!-- 1. DXF Layout View -->
          <Border x:Name="dxfViewerBorder" Margin="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Visibility="Visible">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <userControls:DxfViewer x:Name="dxfViewer" Result="{Binding NestMonitorViewModel.SelectedItem}" SheetIndex="0" />

              <!-- Every layout as a thumbnail: click to show it, tick what has been cut, then nest the rest. -->
              <Border x:Name="layoutStrip" Grid.Row="1" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}"
                      BorderThickness="0,1,0,0" Padding="6,4" Visibility="Collapsed">
                <DockPanel>
                  <!-- Its own line, so the thumbnails get the whole width (a portrait screen had them squeezed). -->
                  <DockPanel DockPanel.Dock="Top" Margin="2,0,2,4">
                    <Button x:Name="btnCutRenest" DockPanel.Dock="Left" Style="{DynamicResource PrimaryButton}" Content="{ui:Tr Btn_CutRenest}" Padding="10,4"
                            Click="OnCutAndRenest" IsEnabled="False" ToolTip="{ui:Tr Tip_CutRenest}" />
                    <TextBlock x:Name="layoutCutSummary" Style="{DynamicResource CaptionText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,0,0"
                               Text="{ui:Tr Hint_MarkCut}" />
                  </DockPanel>
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="layoutStripItems">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border x:Name="card" Margin="3" Padding="4,3" Width="124" Background="White" BorderThickness="2"
                                  BorderBrush="{DynamicResource Brush.Border}" CornerRadius="3" Cursor="Hand"
                                  MouseLeftButtonUp="OnLayoutCardClick" ToolTip="{ui:Tr Tip_LayoutCard}">
                            <StackPanel>
                              <Grid Height="52">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                <Border x:Name="cutBadge" Background="#CC2E7D32" CornerRadius="3" Padding="6,1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                  <TextBlock Text="{Binding CutBadge}" Foreground="White" FontWeight="Bold" />
                                </Border>
                              </Grid>
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" />
                              <CheckBox Content="{ui:Tr Lbl_SheetCut}" IsChecked="{Binding IsCut}" Margin="0,3,0,0"
                                        Visibility="{Binding SingleVisibility}" />
                              <StackPanel Orientation="Horizontal" Margin="0,3,0,0" Visibility="{Binding MultiVisibility}">
                                <TextBlock Text="{ui:Tr Lbl_SheetsCut}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <xctk:IntegerUpDown Width="52" Minimum="0" Maximum="{Binding Count}" Value="{Binding CutCount, Mode=TwoWay}" />
                                <TextBlock Text="{Binding OfCountText}" VerticalAlignment="Center" Margin="4,0,0,0" />
                              </StackPanel>
                            </StackPanel>
                          </Border>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                              <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAnyCut}" Value="True">
                              <Setter TargetName="card" Property="Background" Value="#E8F5E9" />
                              <Setter TargetName="cutBadge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </Grid>
          </Border>

          <!-- 2. PDF Report Preview View -->
          <Grid x:Name="reportPreviewGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- PDF Viewer Toolbar (Sticky) -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="10,6">
              <DockPanel>

                <!-- Left: Navigation and Zoom -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <!-- Page Navigation -->
                  <Button x:Name="btnReportPrevPage" Style="{DynamicResource ModernButton}" MinWidth="36" Padding="8,2" Content="◀" Click="OnReportPrevPage" ToolTip="{ui:Tr Tip_PrevPage}" />
                  <TextBlock x:Name="reportPageIndicatorText" Text="Стр. 1 из 1" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" Margin="8,0" FontWeight="Bold" FontSize="12" />
                  <Button x:Name="btnReportNextPage" Style="{DynamicResource ModernButton}" MinWidth="36" Padding="8,2" Content="▶" Click="OnReportNextPage" ToolTip="{ui:Tr Tip_NextPage}" />

                  <Rectangle Style="{DynamicResource ToolbarSeparator}" Margin="12,2" />

                  <!-- Zoom Controls -->
                  <Button x:Name="btnReportZoomOut" Style="{DynamicResource ModernButton}" MinWidth="36" Padding="8,2" Content="🔍 -" Click="OnReportZoomOut" ToolTip="{ui:Tr Tip_ZoomOut}" />
                  <TextBlock x:Name="reportZoomText" Text="100%" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" Margin="6,0" Width="42" TextAlignment="Center" FontSize="12" />
                  <Button x:Name="btnReportZoomIn" Style="{DynamicResource ModernButton}" MinWidth="36" Padding="8,2" Content="🔍 +" Click="OnReportZoomIn" ToolTip="{ui:Tr Tip_ZoomIn}" />
                  <Button x:Name="btnReportZoom100" Style="{DynamicResource ModernButton}" Margin="4,0" Padding="8,2" Content="100%" Click="OnReportZoom100" ToolTip="{ui:Tr Tip_Zoom100}" />
                  <Button x:Name="btnReportZoomFit" Style="{DynamicResource ModernButton}" Margin="4,0" Padding="8,2" Content="⤢ По ширине" Click="OnReportZoomFit" ToolTip="{ui:Tr Tip_ZoomFit}" />
                  <Button x:Name="btnReportZoomPage" Style="{DynamicResource ModernButton}" Margin="4,0" Padding="8,2" Content="{ui:Tr Btn_ZoomPage}" Click="OnReportZoomPage" ToolTip="{ui:Tr Tip_ZoomPage}" />

                  <Rectangle Style="{DynamicResource ToolbarSeparator}" Margin="12,2" />

                  <!-- Total info -->
                  <TextBlock x:Name="reportSummaryText" Text="Производственный отчёт раскроя" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="6,0" />
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- PDF Pages ScrollViewer -->
            <ScrollViewer x:Name="reportPagesScroll" Grid.Row="1" Background="{DynamicResource Brush.Workspace}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" PreviewMouseWheel="OnReportScrollPreviewMouseWheel" ScrollChanged="OnReportPagesScrollChanged" SizeChanged="OnReportScrollSizeChanged">
              <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24">
                <!-- Stack of A4 Pages -->
                <StackPanel x:Name="reportPagesStackPanel" HorizontalAlignment="Center">
                  <StackPanel.LayoutTransform>
                    <ScaleTransform x:Name="reportScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                  </StackPanel.LayoutTransform>
                </StackPanel>

                <!-- Empty State Notice (if no nest run yet) -->
                <Border x:Name="reportEmptyNotice" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="40" MaxWidth="500" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock x:Name="reportEmptyTitle" Text="Отчёт раскроя ещё не сформирован" FontSize="16" FontWeight="Bold" Foreground="#101828" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock x:Name="reportEmptySub" Text="Выполните нестинг деталей на 3-м экране, чтобы просмотреть и напечатать готовый производственный отчёт со спецификацией и картами резки." TextWrapping="Wrap" TextAlignment="Center" Foreground="#667085" FontSize="13" Margin="0,0,0,18" />
                    <Button Style="{DynamicResource PrimaryButton}" Content="{ui:Tr Btn_GoToNestingShort}" Click="OnGoToNesting" HorizontalAlignment="Center" Padding="16,8" />
                  </StackPanel>
                </Border>
              </Grid>
            </ScrollViewer>
          </Grid>

        </Grid>
      </Grid>

    </Grid>

    <!-- Row 3: Status bar -->
    <Border Grid.Row="3" Background="{DynamicResource Brush.StatusBar}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Height="28">
        <TextBlock x:Name="statusLabelUtilization" Style="{DynamicResource StatusLabel}" Text="Utilization:" />
        <TextBlock Style="{DynamicResource StatusValue}" Foreground="{DynamicResource Brush.Accent}" FontSize="14"
                   Text="{Binding NestMonitorViewModel.SelectedItem.MaterialUtilization, StringFormat={}{0:P1}, FallbackValue=--}" />
        <TextBlock x:Name="statusLabelSheets" Style="{DynamicResource StatusLabel}" Text="Sheets:" />
        <TextBlock Style="{DynamicResource StatusValue}" Text="{Binding NestMonitorViewModel.SelectedItem.UsedSheets.Count, FallbackValue=--}" />
        <TextBlock x:Name="statusLabelPlaced" Style="{DynamicResource StatusLabel}" Text="Placed:" />
        <TextBlock Style="{DynamicResource StatusValue}" Text="{Binding NestMonitorViewModel.SelectedItem.TotalPlacedCount, FallbackValue=--}" />
        <TextBlock x:Name="statusLabelUnplaced" Style="{DynamicResource StatusLabel}" Text="Unplaced:" />
        <TextBlock Style="{DynamicResource StatusValue}" Text="{Binding NestMonitorViewModel.SelectedItem.TotalUnplacedCount, FallbackValue=--}" />
        <!-- Live nest status: elapsed time only, visible while a nest runs and the final time after it ends. -->
        <TextBlock x:Name="statusBarNestPhaseText" Style="{DynamicResource StatusValue}" Visibility="Collapsed" Margin="18,0,6,0" />
        <!-- The part last clicked on a drawing: its name, size and bottom-left corner. -->
        <!-- Startup update check lights this up; click opens the GitHub release page. -->
        <TextBlock x:Name="updateNotice" Style="{DynamicResource StatusValue}" Visibility="Collapsed"
                   Cursor="Hand" TextDecorations="Underline" Margin="18,0,0,0"
                   MouseLeftButtonUp="OnUpdateNoticeClick"
                   ToolTip="{ui:Tr Tip_UpdateNotice}" />
      </StackPanel>
    </Border>

    <!-- Part colour picker popup -->
    <Popup x:Name="partColorPopup" StaysOpen="False" AllowsTransparency="True"
           Placement="Left" HorizontalOffset="-4" PopupAnimation="Fade">
      <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="6">
        <StackPanel>
          <TextBlock Text="{ui:Tr PartColour_Title}" FontWeight="SemiBold" Margin="0,0,0,4" />
          <ItemsControl x:Name="partColorSwatches">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="2" Columns="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{DynamicResource ColourSwatchButton}" Width="34" Height="26" Margin="2"
                        Click="OnPartColorSwatchClick" Tag="{Binding Rgb}" ToolTip="{Binding Label}">
                  <Border Width="34" Height="26" Background="{Binding Brush}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Separator Margin="0,6" />
          <xctk:ColorCanvas x:Name="partColorCanvas" UsingAlphaChannel="False" Width="230"
                            SelectedColorChanged="OnPartColorCanvasChanged" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>

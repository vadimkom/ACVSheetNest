<Window x:Class="DeepNestSharp.Ui.Views.LibrarySaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DeepNestSharp.Ui"
        Title="{ui:Tr Library_SaveTitle}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Panel}">
  <StackPanel Margin="14" MinWidth="360">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="{ui:Tr Library_Group}" VerticalAlignment="Center" Margin="0,0,10,6" />
      <ComboBox x:Name="groupCombo" Grid.Column="1" IsEditable="True" Margin="0,0,0,6" />
      <TextBlock Grid.Row="1" Text="{ui:Tr Library_Name}" VerticalAlignment="Center" Margin="0,0,10,0" />
      <TextBox x:Name="nameText" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center" />
    </Grid>
    <TextBlock x:Name="noteText" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"
               Foreground="{StaticResource Brush.TextMuted}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Style="{StaticResource PrimaryButton}" Content="{ui:Tr Btn_Save}" MinWidth="96" FontSize="13" Padding="18,6" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
      <Button Style="{StaticResource ModernButton}" Content="{ui:Tr Btn_Cancel}" MinWidth="84" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>

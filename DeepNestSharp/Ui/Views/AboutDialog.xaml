<Window x:Class="DeepNestSharp.Ui.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DeepNestSharp.Ui"
        Width="620" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Panel}">
  <Window.Resources>
    <Style x:Key="Link" TargetType="Hyperlink">
      <EventSetter Event="RequestNavigate" Handler="Hyperlink_RequestNavigate" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.Card}">
      <StackPanel Margin="20,16,20,16">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <Image Source="/Branding/sheetnest-icon.png" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="SheetNest" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="versionText" Foreground="{DynamicResource Brush.TextMuted}" />
          </StackPanel>
        </StackPanel>

        <TextBlock Text="{ui:Tr About_Summary}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Text="{ui:Tr About_License}" TextWrapping="Wrap" Margin="0,0,0,14" Foreground="{DynamicResource Brush.TextSecondary}" />

        <TextBlock Text="{ui:Tr About_BasedOn}" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Margin="0,2">
          <Hyperlink NavigateUri="https://github.com/9swampy/DeepNestSharp" Style="{StaticResource Link}">DeepNestSharp</Hyperlink>
          <Run Text=" — " /><Run Text="{ui:Tr About_DeepNestSharp}" />
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,2">
          <Hyperlink NavigateUri="https://github.com/fel88/DeepNestPort" Style="{StaticResource Link}">DeepNestPort</Hyperlink>
          <Run Text=" — " /><Run Text="{ui:Tr About_DeepNestPort}" />
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,2">
          <Hyperlink NavigateUri="https://github.com/Jack000/Deepnest" Style="{StaticResource Link}">DeepNest</Hyperlink>
          <Run Text=" — " /><Run Text="{ui:Tr About_DeepNest}" />
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,2">
          <Hyperlink NavigateUri="https://github.com/JeroenGar/sparrow" Style="{StaticResource Link}">sparrow</Hyperlink>
          <Run Text=" — " /><Run Text="{ui:Tr About_Engine}" />
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,2,0,14">
          <Hyperlink NavigateUri="https://github.com/IxMilia/Dxf" Style="{StaticResource Link}">IxMilia.Dxf</Hyperlink>
          <Run Text=" — " /><Run Text="{ui:Tr About_Dxf}" />
        </TextBlock>

        <TextBlock Text="{ui:Tr About_Contributors}" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Margin="0,2">
          <Hyperlink NavigateUri="https://github.com/kelyamany/DeepNestPort" Style="{StaticResource Link}">kelyamany/DeepNestPort</Hyperlink>
          <Run Text=" — " /><Run Text="{ui:Tr About_NetCore}" />
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,2">
          <Hyperlink NavigateUri="https://github.com/Daniel-t-1/DeepNestPort" Style="{StaticResource Link}">Daniel-t-1/DeepNestPort</Hyperlink>
          <Run Text=" — " /><Run Text="{ui:Tr About_DxfExport}" />
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,2">
          <Hyperlink NavigateUri="https://github.com/9swampy/DeepNestPort" Style="{StaticResource Link}">9swampy/DeepNestPort</Hyperlink>
          <Run Text=" — " /><Run Text="{ui:Tr About_Simplify}" />
        </TextBlock>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,10">
      <Button Content="{ui:Tr Btn_OK}" Click="OkClick" IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButton}" Width="90" HorizontalAlignment="Right" />
    </Border>
  </Grid>
</Window>

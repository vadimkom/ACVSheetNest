<Window x:Class="DeepNestSharp.Ui.Views.AdvancedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:ui="clr-namespace:DeepNestSharp.Ui"
        Title="Advanced Settings"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Panel}">
  <!-- Curated settings dialog: ONLY options the live raster engine / export / app actually consume.
       The old auto-generated property grid exposed ~30 retired NFP/GA engine knobs. -->
  <StackPanel Margin="14" MinWidth="460">

    <GroupBox x:Name="groupNesting" Header="Nesting" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="rotationsLabel" Grid.Row="0" Grid.Column="0" Text="Default part rotations:" VerticalAlignment="Center" Margin="0,0,10,6" />
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="rotationsCombo" Width="200" HorizontalAlignment="Left" Margin="0,0,0,6"
                  ToolTip="{ui:Tr Set_RotationsTip}">
          <ComboBoxItem x:Name="rotItem1" Tag="1">As drawn</ComboBoxItem>
          <ComboBoxItem x:Name="rotItem2" Tag="2">0 / 180°</ComboBoxItem>
          <ComboBoxItem x:Name="rotItem4" Tag="4">90° steps</ComboBoxItem>
          <ComboBoxItem x:Name="rotItem8" Tag="8">45° steps</ComboBoxItem>
          <ComboBoxItem x:Name="rotItem36" Tag="36">Free</ComboBoxItem>
        </ComboBox>

        <TextBlock x:Name="spacingLabel" Grid.Row="1" Grid.Column="0" Text="Part spacing (in):" VerticalAlignment="Center" Margin="0,0,10,6" />
        <xctk:DoubleUpDown Grid.Row="1" Grid.Column="1" x:Name="spacingUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                           Minimum="0" Increment="0.05" FormatString="0.###"
                           ToolTip="{ui:Tr Set_SpacingTip}" />

        <TextBlock x:Name="marginLabel" Grid.Row="2" Grid.Column="0" Text="Sheet edge margin (in):" VerticalAlignment="Center" Margin="0,0,10,6" />
        <xctk:DoubleUpDown Grid.Row="2" Grid.Column="1" x:Name="marginUpDown" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6"
                           Minimum="0" Increment="0.05" FormatString="0.###"
                           ToolTip="{ui:Tr Set_MarginTip}" />

        <TextBlock x:Name="effortLabel" Grid.Row="3" Grid.Column="0" Text="Nesting effort:" VerticalAlignment="Center" Margin="0,0,10,0" />
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="effortCombo" Width="200" HorizontalAlignment="Left"
                  SelectionChanged="OnEffortChanged"
                  ToolTip="{ui:Tr Set_EffortTip}">
          <ComboBoxItem x:Name="effortItem0" Tag="0">Fast</ComboBoxItem>
          <ComboBoxItem x:Name="effortItem1" Tag="1">Normal (default)</ComboBoxItem>
          <ComboBoxItem x:Name="effortItem2" Tag="2">Best (slowest)</ComboBoxItem>
        </ComboBox>

        <TextBlock x:Name="concurrencyLabel" Grid.Row="4" Grid.Column="0" Text="Parallel searches:" VerticalAlignment="Center" Margin="0,6,10,0" />
        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="concurrencyCombo" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0"
                  ToolTip="{ui:Tr Settings_Concurrency_Tip}" />
      </Grid>
    </GroupBox>

    <GroupBox x:Name="groupCommonLine" Header="Common Line Cutting" Padding="8" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="commonLineGapLabel" Grid.Row="0" Grid.Column="0" Text="Common Line Gap (in):"
                   VerticalAlignment="Center" Margin="0,0,10,6" />
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
          <xctk:DoubleUpDown x:Name="commonLineGapUpDown" Width="80" HorizontalAlignment="Left"
                             Increment="0.001" FormatString="0.000##"
                             ToolTip="{ui:Tr Set_GapTip}" />
          <Button x:Name="btnResetCommonLineGap" Style="{StaticResource ModernButton}" Content="Reset to Default" Margin="8,0,0,0" Padding="8,2"
                  Click="OnResetCommonLineGap"
                  ToolTip="{ui:Tr Set_ResetGapTip}" />
        </StackPanel>

        <TextBlock x:Name="clusterPartsLabel" Grid.Row="1" Grid.Column="0" Text="Maximum cluster parts:"
                   VerticalAlignment="Center" Margin="0,0,10,0" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
          <ComboBox x:Name="commonLineClusterModeCombo" Width="90" HorizontalAlignment="Left"
                    SelectionChanged="OnCommonLineClusterModeChanged"
                    ToolTip="{ui:Tr Set_ClusterModeTip}">
            <ComboBoxItem x:Name="clusterItemAuto" Tag="auto">Auto</ComboBoxItem>
            <ComboBoxItem x:Name="clusterItemManual" Tag="manual">Manual</ComboBoxItem>
          </ComboBox>
          <xctk:IntegerUpDown x:Name="commonLineMaxClusterPartsUpDown" Width="58" Margin="6,0,0,0"
                              Minimum="2" Maximum="500" Increment="1"
                              ToolTip="{ui:Tr Set_ClusterMaxTip}" />
          <Button x:Name="btnResetClusterParts" Style="{StaticResource ModernButton}" Content="Reset" Margin="8,0,0,0" Padding="8,2"
                  Click="OnResetCommonLineMaxClusterParts"
                  ToolTip="{ui:Tr Set_ResetClusterTip}" />
        </StackPanel>
      </Grid>
    </GroupBox>

    <GroupBox x:Name="groupDxfExport" Header="DXF export" Padding="8" Margin="0,10,0,0">
      <StackPanel>
        <CheckBox x:Name="mergeLinesCheck" Content="Merge coincident cut lines"
                  ToolTip="{ui:Tr Set_MergeTip}" />
        <CheckBox x:Name="differentiateCheck" Content="Color-differentiate hole contours" Margin="0,8,0,0"
                  ToolTip="{ui:Tr Set_DiffTip}" />
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="partNameExportLabel" Grid.Column="0" Text="Part name text:" VerticalAlignment="Center" Margin="0,0,10,0" />
          <ComboBox Grid.Column="1" x:Name="partNameExportCombo" Width="250" HorizontalAlignment="Left"
                    ToolTip="{ui:Tr Set_PartNamesTip}">
            <ComboBoxItem x:Name="partNameItemNone" Tag="None">None</ComboBoxItem>
            <ComboBoxItem x:Name="partNameItemLayer9" Tag="Layer9">Layer 9 (Engraving / Bends)</ComboBoxItem>
            <ComboBoxItem x:Name="partNameItemBackground" Tag="Background">Background layer (Display only)</ComboBoxItem>
          </ComboBox>
        </Grid>
      </StackPanel>
    </GroupBox>

    <GroupBox x:Name="groupApp" Header="Application" Padding="8" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="unitsLabel" Grid.Row="0" Grid.Column="0" Text="Units:" VerticalAlignment="Center" Margin="0,0,10,8" />
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="unitsCombo" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                  SelectionChanged="OnUnitsChanged"
                  ToolTip="{ui:Tr Set_UnitsTip}">
          <ComboBoxItem x:Name="unitsItemIn" Tag="in">Inches</ComboBoxItem>
          <ComboBoxItem x:Name="unitsItemMm" Tag="mm">Millimeters</ComboBoxItem>
        </ComboBox>

        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="autosaveCheck" Margin="0,0,0,8"
                  Content="Auto save the open project"
                  Checked="OnAutosaveToggled" Unchecked="OnAutosaveToggled"
                  ToolTip="{ui:Tr Set_AutosaveTip}" />

        <TextBlock x:Name="autosaveTimeLabel" Grid.Row="2" Grid.Column="0" Text="Auto Save Time (min):" VerticalAlignment="Center" Margin="18,0,10,0" />
        <xctk:IntegerUpDown Grid.Row="2" Grid.Column="1" x:Name="minutesUpDown" Width="70" HorizontalAlignment="Left"
                            Minimum="1" Maximum="60" Value="5"
                            ToolTip="{ui:Tr Set_AutosaveMinTip}" />
      </Grid>
    </GroupBox>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="okButton" Style="{StaticResource PrimaryButton}" Content="OK" Width="90" FontSize="13" Padding="0,6" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
      <Button x:Name="cancelButton" Style="{StaticResource ModernButton}" Content="Cancel" Width="80" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>

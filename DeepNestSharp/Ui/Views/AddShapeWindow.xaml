<Window x:Class="DeepNestSharp.Ui.Views.AddShapeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:ui="clr-namespace:DeepNestSharp.Ui"
        Title="{ui:Tr Shape_Title}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Panel}">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="110" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,12">
      <RadioButton x:Name="rectangleRadio" Content="{ui:Tr Shape_Rectangle}" IsChecked="True" Margin="0,0,18,0" Checked="OnShapeChanged" />
      <RadioButton x:Name="circleRadio" Content="{ui:Tr Shape_Circle}" Checked="OnShapeChanged" />
    </StackPanel>

    <TextBlock x:Name="widthLabel" Grid.Row="1" Grid.Column="0" Text="{ui:Tr Shape_Width}" VerticalAlignment="Center" Margin="0,0,10,6" />
    <xctk:DoubleUpDown x:Name="widthUpDown" Grid.Row="1" Grid.Column="1" Minimum="0.1" Maximum="25000" Value="100" FormatString="0.##" Margin="0,0,0,6" />
    <TextBlock x:Name="widthUnits" Grid.Row="1" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="6,0,0,6" Foreground="{StaticResource Brush.TextMuted}" />

    <TextBlock x:Name="heightLabel" Grid.Row="2" Grid.Column="0" Text="{ui:Tr Shape_Height}" VerticalAlignment="Center" Margin="0,0,10,6" />
    <xctk:DoubleUpDown x:Name="heightUpDown" Grid.Row="2" Grid.Column="1" Minimum="0.1" Maximum="25000" Value="100" FormatString="0.##" Margin="0,0,0,6" />
    <TextBlock x:Name="heightUnits" Grid.Row="2" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="6,0,0,6" Foreground="{StaticResource Brush.TextMuted}" />

    <TextBlock Grid.Row="3" Grid.Column="0" Text="{ui:Tr Shape_Quantity}" VerticalAlignment="Center" Margin="0,0,10,6" />
    <xctk:IntegerUpDown x:Name="qtyUpDown" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="100000" Value="1" Margin="0,0,0,6" />

    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Style="{StaticResource PrimaryButton}" Content="{ui:Tr Btn_Add}" Width="96" FontSize="13" Padding="0,6" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
      <Button Style="{StaticResource ModernButton}" Content="{ui:Tr Btn_Cancel}" Width="84" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>

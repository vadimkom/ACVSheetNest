<Window x:Class="DeepNestSharp.Ui.Views.AddShapeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:ui="clr-namespace:DeepNestSharp.Ui"
        Title="{ui:Tr Shape_Title}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Panel}">
  <StackPanel Margin="14" MinWidth="320">
    <!-- The fields come from the chosen shape (DeepNestLib.IO.PartShapes): its presets and its parameters. -->
    <Grid x:Name="fieldsGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
    </Grid>

    <TextBlock x:Name="summaryText" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"
               Foreground="{StaticResource Brush.TextMuted}" Visibility="Collapsed" />
    <TextBlock x:Name="problemText" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"
               Foreground="{StaticResource Brush.Danger}" Visibility="Collapsed" />

    <DockPanel Margin="0,12,0,0">
      <Button x:Name="libraryButton" DockPanel.Dock="Left" Style="{StaticResource ModernButton}" Content="{ui:Tr Library_SaveButton}"
              ToolTip="{ui:Tr Library_SaveTip}" Click="OnSaveToLibrary" Margin="0,0,16,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="addButton" Style="{StaticResource PrimaryButton}" Content="{ui:Tr Btn_Add}" MinWidth="96" FontSize="13" Padding="18,6" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
        <Button Style="{StaticResource ModernButton}" Content="{ui:Tr Btn_Cancel}" MinWidth="84" IsCancel="True" />
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>

<UserControl x:Class="DeepNestSharp.Ui.UserControls.DxfViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
  <!-- A neutral gray workspace around the white sheet. -->
  <Grid x:Name="host" Background="{DynamicResource Brush.Workspace}" ClipToBounds="True" Focusable="True"
        MouseWheel="OnMouseWheel"
        MouseLeftButtonDown="OnPanStart" MouseMove="OnPanMove" MouseLeftButtonUp="OnPanEnd"
        MouseDown="OnViewerMouseDown" MouseUp="OnViewerMouseUp"
        MouseRightButtonDown="OnResetView" PreviewKeyDown="OnViewerKeyDown">
    <!-- Canvas is drawn in sheet coordinates (Y already flipped); zoom/pan via RenderTransform.
         Anchor top-left so its origin is the host's (0,0); otherwise WPF centres a fixed-size
         Canvas and FitToView's translate would double-offset it (sheet drifts bottom-right). -->
    <Canvas x:Name="canvas" Background="Transparent"
            HorizontalAlignment="Left" VerticalAlignment="Top">
      <Canvas.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="scale" />
          <TranslateTransform x:Name="translate" />
        </TransformGroup>
      </Canvas.RenderTransform>
    </Canvas>
    <TextBlock x:Name="emptyHint"
               Text="Запустите нестинг, чтобы увидеть результат."
               Foreground="#EFEFEF" FontSize="14"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
    <!-- This also carries the MEASURE readout, and pale grey text put it somewhere between hard to read on
         the gray workspace and invisible on the near-white sheet - which is where it lands once a nest
         fills the view. Same light panel as the edit bar, so it reads over either. -->
    <Border Background="{DynamicResource Brush.Overlay}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="5,2"
            IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
      <TextBlock x:Name="hintText" Text="колесо = масштаб  ·  зажатое колесо = перемещение  ·  правый клик = по размеру окна"
                 Foreground="#101010"  />
    </Border>

    <!-- Manual nesting: select, drag and rotate parts to refine the nest by hand.
         A light panel floating over the drawing. -->
    <Border x:Name="editBar" Background="{DynamicResource Brush.Overlay}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="5,3"
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal">
        <ToggleButton x:Name="editToggle" Content="&#9995; Ручная правка" Padding="8,3" FontWeight="SemiBold"
                      Checked="OnEditModeChanged" Unchecked="OnEditModeChanged"
                      ToolTip="Ручная доводка раскроя: кликните деталь для выбора, перетаскивайте мышью, вращайте кнопками панели." />
        <Button x:Name="undoBtn" Content="&#8630;" Margin="6,0,0,0" Padding="8,3" FontSize="14" IsEnabled="False"
                Click="OnUndoClick" ToolTip="Отменить (Ctrl+Z)" />
        <Button x:Name="redoBtn" Content="&#8631;" Margin="3,0,0,0" Padding="8,3" FontSize="14" IsEnabled="False"
                Click="OnRedoClick" ToolTip="Повторить (Ctrl+Y)" />
        <StackPanel x:Name="rotateButtons" Orientation="Horizontal" Visibility="Collapsed">
          <Button x:Name="btnRotateCcw90" Content="&#8634; 90" Margin="6,0,0,0" Padding="6,3" Click="OnRotateCcw90" ToolTip="Повернуть на 90° против часовой стрелки" />
          <Button x:Name="btnRotateCw90" Content="&#8635; 90" Margin="3,0,0,0" Padding="6,3" Click="OnRotateCw90" ToolTip="Повернуть на 90° по часовой стрелке" />
          <Button x:Name="btnRotateCcw5" Content="&#8634; 5" Margin="6,0,0,0" Padding="6,3" Click="OnRotateCcw5" ToolTip="Повернуть на 5° против часовой стрелки" />
          <Button x:Name="btnRotateCw5" Content="&#8635; 5" Margin="3,0,0,0" Padding="6,3" Click="OnRotateCw5" ToolTip="Повернуть на 5° по часовой стрелке" />
          <Button x:Name="btnMirror" Content="&#8646; Зеркало" Margin="10,0,0,0" Padding="6,3" Click="OnMirror"
                  ToolTip="Отразить зеркально выбранную деталь (влево ↔ вправо). Экспорт DXF также сохранит деталь зеркальной." />
          <Button x:Name="btnMoveToSheet" Margin="10,0,0,0" Padding="6,3" Click="OnMoveToSheetClick" />

        </StackPanel>
        <!-- On a full sheet the part left on top of another can be off screen, so say so in words. -->
        <TextBlock x:Name="overlapCount" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   Foreground="#B00000" Visibility="Collapsed"
                   ToolTip="Детали пересекаются или выходят за лист. Экспорт заблокирован до исправления." />
        <ToggleButton x:Name="measureToggle" Content="Измерение" Margin="12,0,0,0" Padding="8,3" FontWeight="SemiBold"
                      Checked="OnMeasureModeChanged" Unchecked="OnMeasureModeChanged"
                      ToolTip="Измерение расстояний: укажите две точки на чертеже." />
        <!-- The part clicked last: name, size and where it sits, big enough to read at the laser (it used to
             sit in the status bar, small and at the bottom of the window). -->
        <Border x:Name="partInfoPanel" Margin="12,0,0,0" Padding="8,1" CornerRadius="3" VerticalAlignment="Center"
                Background="{DynamicResource Brush.AccentTint}" Visibility="Collapsed">
          <TextBlock x:Name="partInfoText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.TextPrimary}" />
        </Border>
      </StackPanel>
    </Border>

    <!-- The selected part, and the only place its numbers can be typed rather than dragged to. Dragging is
         imprecise and hard over a distance, so anything reachable only by dragging needs a way in from the
         keyboard. X and Y are the part's BOTTOM-LEFT CORNER on the sheet, which is what can be measured on
         the real plate; the placement's own offset is an internal datum and means nothing to an operator.
         Bottom-left is the one free corner: the edit bar is top-left, the hints bottom-right, the layout
         nav bottom-centre, raised above the hint row: in a window 1080 wide (a monitor stood on end) the
         hint reached under it. -->
    <Border x:Name="partInfo" Background="{DynamicResource Brush.Overlay}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="5,3"
            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="partInfoName" Foreground="#101010"  FontWeight="SemiBold"
                   VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="X" Foreground="#101010"  VerticalAlignment="Center" Margin="10,0,3,0" />
        <TextBox x:Name="partX" Width="62"  VerticalAlignment="Center"
                 KeyDown="OnPartFieldKey" LostKeyboardFocus="OnPartFieldCommit"
                 GotKeyboardFocus="OnPartFieldFocus" PreviewMouseLeftButtonDown="OnPartFieldClick"
                 ToolTip="Left edge of the part, in sheet coordinates. Type a value and press Enter." />
        <TextBlock Text="Y" Foreground="#101010"  VerticalAlignment="Center" Margin="8,0,3,0" />
        <TextBox x:Name="partY" Width="62"  VerticalAlignment="Center"
                 KeyDown="OnPartFieldKey" LostKeyboardFocus="OnPartFieldCommit"
                 GotKeyboardFocus="OnPartFieldFocus" PreviewMouseLeftButtonDown="OnPartFieldClick"
                 ToolTip="Bottom edge of the part, in sheet coordinates. Type a value and press Enter." />
        <TextBlock Text="&#8735;" Foreground="#101010" FontSize="13" VerticalAlignment="Center" Margin="8,0,3,0" />
        <TextBox x:Name="partAngle" Width="46"  VerticalAlignment="Center"
                 KeyDown="OnPartFieldKey" LostKeyboardFocus="OnPartFieldCommit"
                 GotKeyboardFocus="OnPartFieldFocus" PreviewMouseLeftButtonDown="OnPartFieldClick"
                 ToolTip="Angle in degrees. Type a value and press Enter." />
        <!-- Measured when the part comes to rest, not on every mouse move: the exact distance between two
             outlines is a search, and a drag asks hundreds of questions per second already. -->
        <TextBlock x:Name="partGap" Foreground="#101010"  VerticalAlignment="Center" Margin="10,0,0,0"
                   ToolTip="Distance from this part to its nearest neighbour, measured when it comes to rest." />
      </StackPanel>
    </Border>

    <!-- Layout navigation, industrial style: one entry per DISTINCT layout,
         its repeat count in parentheses next to the name — "Nest 1/2 (30)" = layout 1 of 2, cut it
         30 times. Totals (utilization / sheets / placed) live in the status bar, not over the plot. -->
    <Border x:Name="sheetNav" Background="{DynamicResource Brush.Overlay}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="5,3"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="btnPrevSheet" Content="&#9664;" Width="28" Click="OnPrevSheet" ToolTip="Предыдущий раскрой" />
        <TextBlock x:Name="sheetLabel" Foreground="Black" VerticalAlignment="Center"
                   Margin="10,0" MinWidth="80" TextAlignment="Center" FontWeight="Bold" />
        <Button x:Name="btnNextSheet" Content="&#9654;" Width="28" Click="OnNextSheet" ToolTip="Следующий раскрой" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

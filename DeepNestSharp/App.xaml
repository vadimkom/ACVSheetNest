<Application x:Class="DeepNestSharp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeepNestSharp"
             ThemeMode="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Fluent (Windows 11) look for the standard controls (ThemeMode, .NET 9+, still marked experimental: WPF0001);
                     this adds the palette and keyed styles. -->
                <ResourceDictionary Source="Ui/Themes/SheetNestTheme.xaml" />
                <ResourceDictionary Source="Ui/Themes/FluentTweaks.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
